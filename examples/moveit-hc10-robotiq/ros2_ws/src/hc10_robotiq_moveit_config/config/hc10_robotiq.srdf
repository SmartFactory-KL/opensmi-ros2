<!--
The semantic description MoveIt plans with: the arm as one planning group from the base to the point
between the fingertips, the gripper as its end effector, the home pose, and the link pairs whose
collisions are not checked because they touch by construction or can never meet.
-->
<robot name="hc10_robotiq">
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>
  <group name="gripper">
    <joint name="robotiq_85_left_knuckle_joint"/>
  </group>

  <!-- Forearm forward, flange pointing down: where the arm starts and ends. -->
  <group_state name="home" group="arm">
    <joint name="joint_1_s" value="0"/>
    <joint name="joint_2_l" value="0"/>
    <joint name="joint_3_u" value="1.5708"/>
    <joint name="joint_4_r" value="0"/>
    <joint name="joint_5_b" value="-1.5708"/>
    <joint name="joint_6_t" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0"/>
  </group_state>

  <end_effector name="gripper" parent_link="tool0" group="gripper" parent_group="arm"/>

  <disable_collisions link1="table" link2="base_link" reason="Adjacent"/>
  <disable_collisions link1="table" link2="link_1_s" reason="Never"/>
  <disable_collisions link1="base_link" link2="link_1_s" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="link_2_l" reason="Never"/>
  <disable_collisions link1="link_1_s" link2="link_2_l" reason="Adjacent"/>
  <disable_collisions link1="link_1_s" link2="link_3_u" reason="Never"/>
  <disable_collisions link1="link_2_l" link2="link_3_u" reason="Adjacent"/>
  <disable_collisions link1="link_3_u" link2="link_4_r" reason="Adjacent"/>
  <disable_collisions link1="link_3_u" link2="link_5_b" reason="Never"/>
  <disable_collisions link1="link_3_u" link2="link_6_t" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="link_5_b" reason="Adjacent"/>
  <disable_collisions link1="link_4_r" link2="link_6_t" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="link_6_t" reason="Adjacent"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="link_4_r" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_base_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="link_5_b" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_base_link" reason="Adjacent"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_left_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_right_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_left_finger_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_right_finger_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_left_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_right_inner_knuckle_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_left_finger_tip_link" reason="Never"/>
  <disable_collisions link1="link_6_t" link2="robotiq_85_right_finger_tip_link" reason="Never"/>
</robot>
