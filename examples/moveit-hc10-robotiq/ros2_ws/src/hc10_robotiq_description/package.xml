<package format="3">
  <name>hc10_robotiq_description</name>
  <version>0.0.0</version>
  <description>The cell of the OpenSMI-ROS2 HC10 example: table, HC10, Robotiq 2F-85, Gazebo world and controllers.</description>
  <maintainer email="noreply@example.com">OpenSMI-ROS2 example</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>motoman_hc10_support</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
